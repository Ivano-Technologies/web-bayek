  "type": {
    "font": "\"Montserrat\",system-ui,-apple-system,\"Segoe UI\",sans-serif",
    "fs-display": "clamp(2.75rem,1.6rem + 5vw,6rem)",
    "fs-h1": "clamp(2.25rem,1.6rem + 2.8vw,4rem)",
    "fs-h2": "clamp(1.75rem,1.4rem + 1.5vw,2.75rem)",
    "fs-h3": "clamp(1.25rem,1.1rem + .6vw,1.625rem)",
    "fs-lead": "clamp(1.125rem,1rem + .45vw,1.375rem)",
    "fs-body": "1.0625rem",
    "fs-small": ".875rem",
    "fs-eyebrow": ".75rem",
    "ls-eyebrow": ".28em",
    "ls-display": "-.025em",
    "lh-tight": "1.04",
    "lh-head": "1.15",
    "lh-body": "1.65",
    "w-light": "300",
    "w-reg": "400",
    "w-med": "500",
    "w-semi": "600",
    "w-bold": "700"
  },
  "space": {
    "s-1": ".25rem",
    "s-2": ".5rem",
    "s-3": ".75rem",
    "s-4": "1rem",
    "s-5": "1.5rem",
    "s-6": "2rem",
    "s-7": "3rem",
    "s-8": "4rem",
    "s-9": "6rem",
    "s-10": "8rem",
    "gutter": "clamp(1.25rem,4vw,3.5rem)",
    "max": "1240px",
    "radius": "0"
  },
  "contrast_notes": {
    "ink on base": "15.9:1",
    "grey-600 on base": "5.4:1 (smallest text colour allowed)",
    "grey-400 on base": "3.5:1 (decorative or 24px+ only)",
    "int-e on white": "2.4:1 fills/E only",
    "int-teal on white": "2.2:1 fills only",
    "int-green-text on white": "5.3:1",
    "int-teal-text on white": "5.2:1",
    "ink on int-e": "7.0:1",
    "ink on int-teal": "7.7:1",
    "white on int-teal-text": "5.2:1",
    "con-e on white": "2.8:1 fills/E only",
    "ink on con-e": "6.1:1",
    "con-clay on white": "4.1:1 blocks; white text 24px+ only",
    "con-red on white": "7.5:1",
    "white on con-red": "7.5:1",
    "con-orange-text on white": "5.5:1"
  },
  "rules": [
    "Bright colours (int-e, int-teal, con-e) never carry body or small text.",
    "Montserrat only.",
    "Ribbon motif is not used."
  ]
}