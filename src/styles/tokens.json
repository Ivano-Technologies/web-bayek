    "int-e": "#50BD36",
    "int-teal": "#41C1BA",
    "int-green-text": "#2F7A1F",
    "int-teal-text": "#1A7A74",
    "int-tint": "#EAF6F5",
    "con-e": "#FD7306",
    "con-clay": "#C65F45",
    "con-red": "#983131",
    "con-orange-text": "#B34700",
    "con-tint": "#F8ECE7"
