    "grey-900": "#3A3434",
    "grey-700": "#5E5858",
    "grey-600": "#6B6565",
    "grey-400": "#8A8484",
    "grey-200": "#E8E4E0",
    "grey-100": "#F1EEEB",
    "ribbon-pink": "#F9DED7",
    "ribbon-mauve": "#D6C5C7",
